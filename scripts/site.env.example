# Site paths for scripts/run_agentr.sh. Copy to scripts/site.env and edit.
#
#   cp scripts/site.env.example scripts/site.env
#
# Nothing here affects results - it is only where things are installed on your machine. Everything
# that affects the numbers (model, task counts, alpha/beta, SFT hyperparameters, eval budget) lives
# in pipeline/config.yaml, which the Kubernetes runs use too.
#
# The values below are the ones used for the Qwen3.5-9B runs on the ARCTIC cluster; they are here as
# a worked example of what each variable should point at.

# --- interpreters -----------------------------------------------------------
# THREE separate Python environments are required, because their dependencies genuinely conflict:
#
#   policy    vLLM + fschat + tiktoken. Runs mcts_collection.py, path_collection.py, eval.py.
#   env       Python 3.8 + the environment server (WebShop pins torch 1.11/spaCy 3.3; ScienceWorld
#             needs Java). Cannot be merged with the policy env.
#   swift     ms-swift >= 4.5.3 with transformers >= 5.2 (Qwen3.5 does not exist in transformers 4.x).
#             Also needs flash-linear-attention and causal-conv1d, or Qwen3.5's Gated DeltaNet layers
#             fall back to slow, memory-hungry PyTorch ops.
AGENTR_POLICY_PYTHON=/usr/bin/python3
AGENTR_ENV_WEBSHOP_PYTHON=/data/envs/agentenv-webshop/bin/python
AGENTR_ENV_SCIWORLD_PYTHON=/data/envs/agentenv-sciworld/bin/python
AGENTR_SWIFT=/opt/conda/envs/swift/bin/swift

# Extra importable path for the policy env: fschat, mmengine, and the other modules the vLLM
# container lacked. Leave as an empty existing directory if your policy env already has them.
AGENTR_POLICY_SITE=/data/envs/policy-site

# --- model cache ------------------------------------------------------------
AGENTR_HF_HOME=/data/models/huggingface

# --- environment sources ----------------------------------------------------
# eto protocol (matches the Co-Evolving / ETO papers' environments):
#   a checkout of the Co-Evolving-Agents repo, with WebShop's full product catalogue downloaded
#   into envs/webshop/src and the ScienceWorld split files under eval_agent/data/sciworld.
AGENTR_WEBSHOP_ETO_ROOT=/data/src/webshop-eto
AGENTR_SCIWORLD_ETO_ROOT=/data/src/sciworld-eto

# agentgym protocol (Agent-R's released setup), only needed if you set *_protocol: agentgym:
AGENTR_AGENTGYM_ROOT=/data/src/AgentGym                # upstream, for WebShop
AGENTR_AGENTGYM_AGENTR_ROOT=/data/src/AgentGym-agentr  # + the maintainers' SciWorld files (issues #5, #8)
AGENTR_ENV_WEBSHOP_BIN=/data/envs/agentenv-webshop/bin/webshop
