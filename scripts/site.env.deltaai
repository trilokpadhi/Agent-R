# Site paths for DeltaAI (NCSA). Copy to scripts/site.env on that machine.
# Nothing here affects results - only where things are installed. See site.env.example.
#
# Three venvs built by k8s-free build scripts under /work/nvme/biqx/$USER/agentr:
#   env-policy    vLLM 0.27.1 + torch 2.13.0+cu129 + transformers 5.10.4 + fschat + mmengine
#   env-sciworld  scienceworld 1.2.3 (bundled JAR) on the system OpenJDK 11 aarch64
#   env-swift     ms-swift 4.5.3 + deepspeed 0.19.7 (built from source for aarch64)
# transformers is 5.10.4 in BOTH policy and trainer, so a checkpoint written by one is readable by
# the other - the v4/v5 split that broke Gemma on the other cluster cannot happen here.

AGENTR_POLICY_PYTHON=/work/nvme/biqx/tpadhi/agentr/env-policy/bin/python
AGENTR_ENV_SCIWORLD_PYTHON=/work/nvme/biqx/tpadhi/agentr/env-sciworld/bin/python
AGENTR_ENV_WEBSHOP_PYTHON=/work/nvme/biqx/tpadhi/agentr/env-sciworld/bin/python   # unused: sciworld only
AGENTR_SWIFT=/work/nvme/biqx/tpadhi/agentr/env-swift/bin/swift

# fschat and mmengine are installed inside env-policy, so nothing extra is needed on PYTHONPATH.
AGENTR_POLICY_SITE=/work/nvme/biqx/tpadhi/agentr/empty-site

AGENTR_HF_HOME=/work/nvme/biqx/tpadhi/agentr/hf

# The eto clients read their instruction, ICL and split files from these at IMPORT time.
AGENTR_SCIWORLD_ETO_ROOT=/work/nvme/biqx/tpadhi/agentr/sciworld-eto
AGENTR_WEBSHOP_ETO_ROOT=/work/nvme/biqx/tpadhi/agentr/webshop-eto      # not staged; sciworld only
AGENTR_INTERCODE_ETO_ROOT=/work/nvme/biqx/tpadhi/agentr/intercode-sql-eto
